#COMPARAR PUERTAS CON LOTES
-- Comparación de puertas con lotes
SELECT
    p.rowid AS puerta_rowid,
    lote.rowid AS lote_rowid,
    p.cod_mzna AS puerta_mzna,
    lote.cod_mzna AS lote_mzna,
    p.cod_lote AS puerta_lote,
    lote.cod_lote AS lote_lote,
    p.ubigeo AS puerta_ubigeo,
    lote.ubigeo AS lote_ubigeo,
    p.cod_sector AS puerta_sector,
    lote.cod_sector AS lote_sector,
    CASE 
        WHEN lote.rowid IS NULL THEN 'FUERA DE LOTE'
        ELSE 'DIFERENCIA EN CAMPOS'
    END AS error_tipo
FROM tg_puerta AS p
LEFT JOIN tg_lote AS lote
  ON ST_Contains(lote.geom, p.geom)
WHERE 
      lote.rowid IS NULL
   OR (p.cod_mzna != lote.cod_mzna OR (p.cod_mzna IS NULL AND lote.cod_mzna IS NOT NULL) OR (p.cod_mzna IS NOT NULL AND lote.cod_mzna IS NULL))
   OR (p.cod_lote  != lote.cod_lote  OR (p.cod_lote IS NULL AND lote.cod_lote IS NOT NULL) OR (p.cod_lote IS NOT NULL AND lote.cod_lote IS NULL))
   OR (p.ubigeo    != lote.ubigeo    OR (p.ubigeo IS NULL AND lote.ubigeo IS NOT NULL) OR (p.ubigeo IS NOT NULL AND lote.ubigeo IS NULL))
   OR (p.cod_sector != lote.cod_sector OR (p.cod_sector IS NULL AND lote.cod_sector IS NOT NULL) OR (p.cod_sector IS NOT NULL AND lote.cod_sector IS NULL));

#COMPARAR EDIFICA CON LOTES
-- Crear centroides de tg_edifica
WITH edificas_punto AS (
    SELECT
        rowid AS edifica_rowid,
        ST_Centroid(geom) AS geom,
        cod_mzna,
        cod_lote,
        ubigeo,
        cod_sector
    FROM tg_edifica
)

-- Comparación con los lotes
SELECT
    e.edifica_rowid,
    lote.rowid AS lote_rowid,
    e.cod_mzna AS edifica_mzna,
    lote.cod_mzna AS lote_mzna,
